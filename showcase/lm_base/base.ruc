# The base for bigger language models; functions in plain Rucas on signed numbers with 12 bits after the point

BITS 32                 # room for the product of two numbers up to 8, with 24 bits after the point

JMP 1
ADD 31                  # return notes go on the tape in cells 32 to 47, since CLRS wipes the stack before every sum
JMP 6
ADD 1                   # steps of 1 walk along a row; set the row length instead to walk down a column
JMPR
ADD 1
JMPR
ADD 96                  # ALLOC hands out cells from here, so a model never needs a fixed address; 48 to 95 are the program's own
JMPR
ADD 4096                # STEP divides by this; 4096 / rate makes it a learning step of that rate
JMP 10
ADD 4096                # 1.0; a cell holds whole numbers only, so every number is stored times 4096
JMPR
ADD 45                  # PSHS and PRNTA only work on cells, so the characters and numbers they need get cells
JMPR
ADD 46
JMPR
ADD 10000
JMPR
ADD 48
JMPR
ADD 10
JMPR
ADD 2839                # ln 2, for exp
JMPR
ADD 16777216            # 1.0 times 1.0, for dividing 1 by a number
JMP 31
ADD 2018                # the random state, so every run starts the same and can be checked
JMP 0
ADD 1                   # the program starts at its piece 1; the base keeps 100 and up, so the two never clash

STLP                    # Rucas cannot jump, so one loop runs every piece; the program's own file closes it
	JMP 0                   # IF EQL looks at the current cell, so every piece starts back on cell 0
	IF EQL 100              # FMUL, c = a * b
		CLRS
		JMP 2
		PSHS
		JMP 3
		PSHS
		MULS
		JMP 4
		EQL TOPS                # wrapped to 32 bits a signed product is still right, but it has 24 bits after the point

		IF MORE 2147483647      # negative, and DIVS knows no minus, so it divides the size and puts the minus back
			CLRS
			PSHS
			SUB $CELL
			SUB $STACK
			CLRS
			JMP 10
			PSHS
			JMP 4
			PSHS
			DIVS
			EQL TOPS
			CLRS
			PSHS
			SUB $CELL
			SUB $STACK
		ELSE
			CLRS
			JMP 10
			PSHS
			JMP 4
			PSHS
			DIVS
			EQL TOPS
		ENDIF

		JMP 1                   # return, to the piece written on the top note
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 110              # MATVEC, line j of the matrix at a times the list at b goes to place j of the list at c
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 2
		PSHS
		JMP 23
		EQL TOPS
		CLRS
		JMP 4
		PSHS
		JMP 24
		EQL TOPS
		CLRS
		JMP 18
		PSHS
		JMP 21
		EQL TOPS

		JMP 21
		STLP                    # one line per round; cell 18 says how many lines, cell 19 how far apart they start
			CLRS
			JMP 23
			PSHS
			JMP 28
			EQL TOPS
			CLRS
			JMP 3
			PSHS
			JMP 30
			EQL TOPS
			CLRS
			JMP 5
			PSHS
			JMP 29
			EQL TOPS
			JMP 24
			JMP $CELL
			SUB $CELL

			JMP 29
			STLP
				CLRS
				JMP 28
				JMP $CELL
				PSHS
				JMP 30
				JMP $CELL
				PSHS
				MULS                    # multiplied here and not by FMUL, since a call for every number costs a trip around the loop
				JMP 20
				EQL TOPS
				IF MORE 2147483647      # the same sign trick as FMUL
					CLRS
					PSHS
					SUB $CELL
					SUB $STACK
					CLRS
					JMP 10
					PSHS
					JMP 20
					PSHS
					DIVS
					JMP 24
					JMP $CELL
					SUB $STACK
				ELSE
					CLRS
					JMP 10
					PSHS
					JMP 20
					PSHS
					DIVS
					JMP 24
					JMP $CELL
					ADD $STACK
				ENDIF

				CLRS                    # with steps, the same MATVEC reads rows going forward and columns going back
				JMP 6
				PSHS
				JMP 28
				ADD $STACK
				JMP 7
				PSHS
				JMP 30
				ADD $STACK
				JMP 29
				SUB
			NDLP

			CLRS
			JMP 19
			PSHS
			JMP 23
			ADD $STACK
			JMP 24
			ADD
			JMP 21
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 120              # PRNT, print the n numbers from a, a step apart, one per line with four decimals
		CLRS                    # copies, so a and n stay as the caller left them
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS

		JMP 29
		STLP
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 20
			EQL TOPS                # a copy, so printing leaves the number as it was

			IF MORE 2147483647      # PRNTD knows no minus either, so print one and go on with the size
				JMP 11
				PRNTA
				JMP 20
				CLRS
				PSHS
				SUB $CELL
				SUB $STACK
			ENDIF

			CLRS
			JMP 10
			PSHS
			JMP 20
			PSHS
			DIVS
			JMP 21
			EQL TOPS
			PRNTD
			JMP 12
			PRNTA

			CLRS
			JMP 10
			PSHS
			JMP 20
			PSHS
			MODS
			JMP 21
			EQL TOPS
			CLRS                    # 4096ths into ten-thousandths, for four decimals
			JMP 13
			PSHS
			JMP 21
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 21
			PSHS
			DIVS
			EQL TOPS
			IF LESS 1000            # PRNTD drops leading zeros, so 0.0625 needs its zero put back
				JMP 14
				PRNTA
			ENDIF
			JMP 21
			IF LESS 100
				JMP 14
				PRNTA
			ENDIF
			JMP 21
			IF LESS 10
				JMP 14
				PRNTA
			ENDIF
			JMP 21
			PRNTD
			JMP 15
			PRNTA

			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 130              # ALLOC, c = the first of n fresh cells; nothing is given back, since a model sets up its lists once
		CLRS
		JMP 8
		PSHS
		JMP 4
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 8
		ADD $STACK

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 140              # EXP1, cell 22 becomes e to the power cell 22; EXP and TANH share it
		JMP 27
		SUB $CELL
		JMP 22
		IF MORE 2147483647      # e^-x = 1 / e^x, so work with the size and divide at the end
			JMP 27
			ADD
			JMP 22
			CLRS
			PSHS
			SUB $CELL
			SUB $STACK
		ENDIF
		IF MORE 49152           # e^12 is about the most a cell holds, and e^-12 rounds to 0 anyway
			SUB $CELL
			ADD 49152
		ENDIF

		CLRS                    # x = k ln 2 + r, so e^x = 2^k e^r with r small enough for a short series
		JMP 16
		PSHS
		JMP 22
		PSHS
		DIVS
		JMP 23
		EQL TOPS
		CLRS
		JMP 16
		PSHS
		JMP 22
		PSHS
		MODS
		JMP 24
		EQL TOPS

		CLRS
		JMP 10
		PSHS
		JMP 25
		EQL TOPS
		JMP 26
		SUB $CELL
		ADD 5
		STLP                    # e^r = 1 + r(1 + r/2(1 + r/3(1 + r/4(1 + r/5)))), worked from the inside out
			CLRS
			JMP 24
			PSHS
			JMP 25
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 25
			PSHS
			DIVS
			EQL TOPS
			CLRS
			JMP 26
			PSHS
			JMP 25
			PSHS
			DIVS
			EQL TOPS
			ADD 4096
			JMP 26
			SUB
		NDLP

		JMP 23
		STLP                    # doubling k times is the 2^k
			JMP 25
			ADD $CELL
			JMP 23
			SUB
		NDLP

		JMP 27
		IF
			CLRS
			JMP 25
			PSHS
			JMP 17
			PSHS
			DIVS
			JMP 25
			EQL TOPS
		ENDIF
		CLRS
		JMP 25
		PSHS
		JMP 22
		EQL TOPS

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 150              # EXP, each of the n numbers from a, a step apart, becomes e to its power
		CLRS                    # copies, so a and n stay as the caller left them
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS
		JMP 0
		SUB $CELL
		ADD 151
	ENDIF
	JMP 0
	IF EQL 151              # one number per round; a call cannot sit inside STLP, so this loop runs through pieces
		JMP 29
		IF
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 22
			EQL TOPS
			JMP 1
			ADD
			JMP $CELL
			ADD 152
			JMP 0
			SUB $CELL
			ADD 140
		ELSE
			JMP 1                   # return
			JMP $CELL
			CLRS
			PSHS
			SUB $CELL
			JMP 1
			SUB
			JMP 0
			EQL TOPS
		ENDIF
	ENDIF
	JMP 0
	IF EQL 152
		CLRS
		JMP 22
		PSHS
		JMP 28
		JMP $CELL
		EQL TOPS
		CLRS
		JMP 6
		PSHS
		JMP 28
		ADD $STACK
		JMP 29
		SUB
		JMP 0
		SUB $CELL
		ADD 151
	ENDIF
	JMP 0
	IF EQL 160              # TANH, each of the n numbers from a, a step apart, becomes its tanh
		CLRS                    # copies, so a and n stay as the caller left them
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS
		JMP 0
		SUB $CELL
		ADD 161
	ENDIF
	JMP 0
	IF EQL 161              # the same loop through pieces as EXP
		JMP 29
		IF
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 22
			EQL TOPS
			JMP 30
			SUB $CELL
			JMP 22
			IF MORE 2147483647      # tanh(-x) = -tanh(x), so work with the size and put the sign back after
				JMP 30
				ADD
				JMP 22
				CLRS
				PSHS
				SUB $CELL
				SUB $STACK
			ENDIF
			IF MORE 32768           # tanh(8) is 1 to four decimals, and the doubling below must not wrap
				SUB $CELL
				ADD 32768
			ENDIF
			ADD $CELL               # e^2x, since tanh(x) = 1 - 2 / (e^2x + 1)
			JMP 1
			ADD
			JMP $CELL
			ADD 162
			JMP 0
			SUB $CELL
			ADD 140
		ELSE
			JMP 1                   # return
			JMP $CELL
			CLRS
			PSHS
			SUB $CELL
			JMP 1
			SUB
			JMP 0
			EQL TOPS
		ENDIF
	ENDIF
	JMP 0
	IF EQL 162
		CLRS
		JMP 10
		PSHS
		JMP 22
		ADD $STACK
		CLRS
		PSHS
		JMP 17
		PSHS
		DIVS
		JMP 22
		EQL TOPS
		ADD $CELL
		CLRS
		PSHS
		SUB $CELL
		ADD 4096
		SUB $STACK
		JMP 30
		IF
			JMP 22
			CLRS
			PSHS
			SUB $CELL
			SUB $STACK
		ENDIF

		CLRS
		JMP 22
		PSHS
		JMP 28
		JMP $CELL
		EQL TOPS
		CLRS
		JMP 6
		PSHS
		JMP 28
		ADD $STACK
		JMP 29
		SUB
		JMP 0
		SUB $CELL
		ADD 161
	ENDIF
	JMP 0
	IF EQL 165              # DTANH, each of the n numbers from a gets times 1 - b[i]^2, the slope of tanh where it gave b[i]
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 3
		PSHS
		JMP 30
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS

		JMP 29
		STLP
			CLRS
			JMP 30
			JMP $CELL
			PSHS
			PSHS
			MULS                    # a square is never below 0, even when b[i] is
			JMP 20
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 20
			PSHS
			DIVS
			EQL TOPS
			CLRS
			PSHS
			SUB $CELL
			ADD 4096
			SUB $STACK

			CLRS
			JMP 20
			PSHS
			JMP 28
			JMP $CELL
			PSHS
			MULS
			JMP 21
			EQL TOPS
			IF MORE 2147483647      # the same sign trick as FMUL
				CLRS
				PSHS
				SUB $CELL
				SUB $STACK
				CLRS
				JMP 10
				PSHS
				JMP 21
				PSHS
				DIVS
				JMP 21
				EQL TOPS
				CLRS
				PSHS
				SUB $CELL
				SUB $STACK
			ELSE
				CLRS
				JMP 10
				PSHS
				JMP 21
				PSHS
				DIVS
				JMP 21
				EQL TOPS
			ENDIF
			CLRS
			JMP 21
			PSHS
			JMP 28
			JMP $CELL
			EQL TOPS

			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 7
			PSHS
			JMP 30
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 170              # RAND, each of the n numbers from a becomes a random number from b up to, not including, b + c
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS

		JMP 29
		STLP
			CLRS                    # state * 1103515245 + 12345 visits all 2^32 values before it repeats
			JMP 20
			SUB $CELL
			ADD 1103515245
			PSHS
			JMP 31
			PSHS
			MULS
			EQL TOPS
			ADD 12345
			CLRS                    # the low bits of that repeat quickly, so only the top 16 count
			JMP 20
			SUB $CELL
			ADD 65536
			PSHS
			JMP 31
			PSHS
			DIVS
			JMP 20
			EQL TOPS
			CLRS
			JMP 4
			PSHS
			JMP 20
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 21
			SUB $CELL
			ADD 65536
			PSHS
			JMP 20
			PSHS
			DIVS
			JMP 3
			PSHS
			ADDS
			JMP 28
			JMP $CELL
			EQL TOPS

			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 180              # COPY, the n numbers from a go to b, each list with its own step
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 3
		PSHS
		JMP 30
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS

		JMP 29
		STLP
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 30
			JMP $CELL
			EQL TOPS
			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 7
			PSHS
			JMP 30
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 190              # STEP, a learning step; weight i of line j in the matrix at c loses a[j] * b[i] / cell 9
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 4
		PSHS
		JMP 23
		EQL TOPS
		CLRS
		JMP 2
		PSHS
		JMP 25
		EQL TOPS
		CLRS
		JMP 18
		PSHS
		JMP 21
		EQL TOPS

		JMP 21
		STLP                    # one line per round, as in MATVEC
			CLRS
			JMP 23
			PSHS
			JMP 28
			EQL TOPS
			CLRS
			JMP 3
			PSHS
			JMP 30
			EQL TOPS
			CLRS
			JMP 5
			PSHS
			JMP 29
			EQL TOPS
			CLRS
			JMP 25
			JMP $CELL
			PSHS
			JMP 26
			EQL TOPS

			JMP 29
			STLP
				CLRS
				JMP 26
				PSHS
				JMP 30
				JMP $CELL
				PSHS
				MULS
				JMP 20
				EQL TOPS
				IF MORE 2147483647      # divided once, after the whole product, or the small steps of learning would round away to 0
					CLRS
					PSHS
					SUB $CELL
					SUB $STACK
					CLRS
					JMP 9
					PSHS
					JMP 20
					PSHS
					DIVS
					JMP 28
					JMP $CELL
					ADD $STACK
				ELSE
					CLRS
					JMP 9
					PSHS
					JMP 20
					PSHS
					DIVS
					JMP 28
					JMP $CELL
					SUB $STACK
				ENDIF

				JMP 28
				ADD
				CLRS
				JMP 7
				PSHS
				JMP 30
				ADD $STACK
				JMP 29
				SUB
			NDLP

			CLRS
			JMP 19
			PSHS
			JMP 23
			ADD $STACK
			CLRS
			JMP 6
			PSHS
			JMP 25
			ADD $STACK
			JMP 21
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 200              # SOFTMAX, the n numbers from a become chances that add up to 1.0
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS
		JMP 21
		SUB $CELL

		JMP 29
		STLP                    # the largest; flipping the top bit makes IF MORE compare numbers below 0 the right way
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 20
			EQL TOPS
			ADD 2147483648
			CLRS
			JMP 21
			PSHS
			JMP 20
			IF MORE $STACK
				CLRS
				PSHS
				JMP 21
				EQL TOPS
			ENDIF
			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP
		JMP 21
		SUB 2147483648

		CLRS
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS
		JMP 29
		STLP                    # minus the largest, so EXP only gets 0 and below and never runs out of room
			CLRS
			JMP 21
			PSHS
			JMP 28
			JMP $CELL
			SUB $STACK
			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # EXP needs a call, so the rest goes on in piece 201
		ADD
		JMP $CELL
		ADD 201
		JMP 0
		SUB $CELL
		ADD 150
	ENDIF
	JMP 0
	IF EQL 201
		CLRS
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS
		JMP 21
		SUB $CELL
		JMP 29
		STLP
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 21
			ADD $STACK
			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP

		CLRS
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS
		JMP 29
		STLP                    # each one divided by the sum, so they add up to 1.0
			CLRS
			JMP 10
			PSHS
			JMP 28
			JMP $CELL
			PSHS
			MULS
			JMP 20
			EQL TOPS
			CLRS
			JMP 21
			PSHS
			JMP 20
			PSHS
			DIVS
			JMP 28
			JMP $CELL
			EQL TOPS
			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
	JMP 0
	IF EQL 210              # LOG, each of the n numbers from a becomes its natural log
		CLRS                    # copies, so the caller's cells stay as they were
		JMP 2
		PSHS
		JMP 28
		EQL TOPS
		CLRS
		JMP 5
		PSHS
		JMP 29
		EQL TOPS

		JMP 29
		STLP
			CLRS
			JMP 28
			JMP $CELL
			PSHS
			JMP 20
			EQL TOPS
			IF MORE 2147483647      # 0 and below have no log, so they count as the smallest step
				SUB $CELL
			ENDIF
			IF EQL 0
				ADD
			ENDIF
			JMP 21
			SUB $CELL

			JMP 22                  # halve into 1 to 2 and count, since the log of 2^k m is k ln 2 + the log of m
			SUB $CELL
			JMP 20
			IF MORE 8191
				JMP 22
				ADD
			ENDIF
			JMP 22
			STLP
				CLRS
				JMP 22
				SUB $CELL
				ADD 2
				PSHS
				JMP 20
				PSHS
				DIVS
				EQL TOPS
				JMP 21
				ADD
				JMP 22
				SUB $CELL
				JMP 20
				IF MORE 8191
					JMP 22
					ADD
				ENDIF
				JMP 22
			NDLP
			JMP 22                  # or double up into it
			SUB $CELL
			JMP 20
			IF LESS 4096
				JMP 22
				ADD
			ENDIF
			JMP 22
			STLP
				JMP 20
				ADD $CELL
				JMP 21
				SUB
				JMP 22
				SUB $CELL
				JMP 20
				IF LESS 4096
					JMP 22
					ADD
				ENDIF
				JMP 22
			NDLP

			CLRS                    # 2z = 2(m - 1)/(m + 1), and log m = 2z(1 + z^2/3 + z^4/5 + z^6/7), short since z stays below 1/3
			JMP 20
			PSHS
			JMP 23
			EQL TOPS
			ADD 4096
			JMP 20
			SUB 4096
			CLRS
			JMP 24
			SUB $CELL
			ADD 8192
			PSHS
			JMP 20
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 23
			PSHS
			JMP 20
			PSHS
			DIVS
			JMP 24
			EQL TOPS
			CLRS
			PSHS
			PSHS
			MULS
			JMP 25
			EQL TOPS
			CLRS
			JMP 26
			SUB $CELL
			ADD 16384
			PSHS
			JMP 25
			PSHS
			DIVS
			EQL TOPS

			JMP 26
			SUB $CELL
			ADD 585
			CLRS
			JMP 25
			PSHS
			JMP 26
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 26
			PSHS
			DIVS
			EQL TOPS
			ADD 819
			CLRS
			JMP 25
			PSHS
			JMP 26
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 26
			PSHS
			DIVS
			EQL TOPS
			ADD 1365
			CLRS
			JMP 25
			PSHS
			JMP 26
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 26
			PSHS
			DIVS
			EQL TOPS
			ADD 4096
			CLRS
			JMP 24
			PSHS
			JMP 26
			PSHS
			MULS
			EQL TOPS
			CLRS
			JMP 10
			PSHS
			JMP 26
			PSHS
			DIVS
			EQL TOPS

			CLRS                    # plus k ln 2; MULS wraps, which keeps it right for a k below 0
			JMP 21
			PSHS
			JMP 16
			PSHS
			MULS
			JMP 26
			ADD $STACK
			CLRS
			JMP 26
			PSHS
			JMP 28
			JMP $CELL
			EQL TOPS

			CLRS
			JMP 6
			PSHS
			JMP 28
			ADD $STACK
			JMP 29
			SUB
		NDLP

		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF
