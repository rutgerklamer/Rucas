# A network that reads 100,000 characters of Shakespeare once, learning which symbol comes after the 4 before it, then writes 1,000 characters of its own

	JMP 0
	IF EQL 1                # one ALLOC for the whole network, so every part is a fixed distance from the start
		JMP 5
		SUB $CELL
		ADD 7408
		JMP 1
		ADD
		JMP $CELL
		ADD 2
		JMP 0
		SUB $CELL
		ADD 130
	ENDIF
	JMP 0
	IF EQL 2                # C 36 x 16, W1 64 x 65, W2 36 x 65, then x, h, p, dh, dx and the alphabet
		CLRS
		JMP 4
		PSHS
		JMP 50
		EQL TOPS
		JMP 51
		EQL TOPS
		ADD 576
		JMP 52
		EQL TOPS
		ADD 4736
		JMP 53
		EQL TOPS
		ADD 7076
		JMP 54
		EQL TOPS
		ADD 7141
		JMP 55
		EQL TOPS
		ADD 7206
		JMP 56
		EQL TOPS
		ADD 7242
		JMP 57
		EQL TOPS
		ADD 7307
		JMP 58
		EQL TOPS
		ADD 7372
		JMP 53                  # x and h end in a 1.0, which turns the last weight of every line into its bias
		JMP $CELL
		JMPR 64
		ADD 4096
		JMP 54
		JMP $CELL
		JMPR 64
		ADD 4096

		JMP 58                  # the alphabet holds the character of every symbol; symbol 0 is a line break, then a to z
		JMP $CELL
		ADD 10
		JMPR
		ADD 97
		STLP                    # each letter is one more than the one before, until z
			CLRS
			PSHS
			JMPR
			EQL TOPS
			ADD
			IF EQL 123
				SUB $CELL
			ENDIF
		NDLP
		ADD 32                  # then a space and 8 marks
		JMPR
		ADD 44
		JMPR
		ADD 46
		JMPR
		ADD 58
		JMPR
		ADD 59
		JMPR
		ADD 39
		JMPR
		ADD 63
		JMPR
		ADD 33
		JMPR
		ADD 45

		CLRS                    # every weight starts small and random, since equal weights would all learn the same thing
		JMP 50
		PSHS
		JMP 2
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 576
		JMP 3
		SUB $CELL
		SUB 4096
		JMP 4
		SUB $CELL
		ADD 8192
		JMP 1
		ADD
		JMP $CELL
		ADD 3
		JMP 0
		SUB $CELL
		ADD 170
	ENDIF
	JMP 0
	IF EQL 3
		CLRS
		JMP 51
		PSHS
		JMP 2
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 4160
		JMP 3
		SUB $CELL
		SUB 819
		JMP 4
		SUB $CELL
		ADD 1638
		JMP 1
		ADD
		JMP $CELL
		ADD 4
		JMP 0
		SUB $CELL
		ADD 170
	ENDIF
	JMP 0
	IF EQL 4
		CLRS
		JMP 52
		PSHS
		JMP 2
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 2340
		JMP 3
		SUB $CELL
		SUB 410
		JMP 4
		SUB $CELL
		ADD 820
		JMP 1
		ADD
		JMP $CELL
		ADD 5
		JMP 0
		SUB $CELL
		ADD 170
	ENDIF
	JMP 0
	IF EQL 5
		JMP 59
		ADD 75000               # symbols at a rate of 0.02, after which the steps shrink to 0.005, so the weights settle
		JMP 60
		ADD 10000
		JMP 9
		SUB $CELL
		ADD 204800              # 4096 / 0.02
		JMP 0
		SUB $CELL
		ADD 10
	ENDIF

	JMP 0
	IF EQL 10               # the text is read once, learning from every symbol as it comes, so it can be as long as you like
		JMP 73
		CINP
		IF                      # 0 is the end of the input
			IF MORE 64              # capitals count as small letters
				IF LESS 91
					ADD 32
				ENDIF
			ENDIF
			JMP 62                  # look the character up in the alphabet; k = 36 means it is no symbol, so it is skipped
			SUB $CELL
			JMP 71
			SUB $CELL
			ADD 36
			STLP
				CLRS
				JMP 58
				PSHS
				JMP 62
				PSHS
				ADDS
				JMP $STACK
				PSHS
				JMP 73
				IF EQL $STACK
					JMP 71
					SUB $CELL
				ELSE
					JMP 62
					ADD
					JMP 71
					SUB
				ENDIF
			NDLP
			JMP 62
			IF LESS 36
				JMP 1
				ADD
				JMP $CELL
				ADD 11
				JMP 0
				SUB $CELL
				ADD 30
			ENDIF
		ELSE
			JMP 0
			SUB $CELL
			ADD 40
		ENDIF
	ENDIF
	JMP 0
	IF EQL 11               # the loss is minus the log of the chance the network gave the right symbol
		CLRS
		JMP 55
		PSHS
		JMP 62
		PSHS
		ADDS
		JMP $STACK
		PSHS
		JMP 68
		EQL TOPS
		JMP 2
		SUB $CELL
		ADD 68
		JMP 5
		SUB $CELL
		ADD
		JMP 1
		ADD
		JMP $CELL
		ADD 12
		JMP 0
		SUB $CELL
		ADD 210
	ENDIF
	JMP 0
	IF EQL 12               # learning starts at the scores, where the error is simply p, minus 1.0 for the right symbol
		CLRS
		JMP 68
		PSHS
		JMP 67
		SUB $STACK
		CLRS
		JMP 55
		PSHS
		JMP 62
		PSHS
		ADDS
		JMP $STACK
		SUB 4096

		CLRS                    # the error sent back to h, read down the columns of W2 before W2 changes
		JMP 52
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 55
		PSHS
		JMP 3
		EQL TOPS
		CLRS
		JMP 56
		PSHS
		JMP 4
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 36
		JMP 18
		SUB $CELL
		ADD 65
		JMP 19
		SUB $CELL
		ADD
		JMP 6
		SUB $CELL
		ADD 65
		JMP 1
		ADD
		JMP $CELL
		ADD 13
		JMP 0
		SUB $CELL
		ADD 110
	ENDIF
	JMP 0
	IF EQL 13
		JMP 6
		SUB $CELL
		ADD
		CLRS
		JMP 55
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 54
		PSHS
		JMP 3
		EQL TOPS
		CLRS
		JMP 52
		PSHS
		JMP 4
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 65
		JMP 18
		SUB $CELL
		ADD 36
		JMP 19
		SUB $CELL
		ADD 65
		JMP 1
		ADD
		JMP $CELL
		ADD 14
		JMP 0
		SUB $CELL
		ADD 190
	ENDIF
	JMP 0
	IF EQL 14               # back through tanh
		CLRS
		JMP 56
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 54
		PSHS
		JMP 3
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 64
		JMP 1
		ADD
		JMP $CELL
		ADD 15
		JMP 0
		SUB $CELL
		ADD 165
	ENDIF
	JMP 0
	IF EQL 15               # the error sent back to x, read down the columns of W1 before W1 changes
		CLRS
		JMP 51
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 56
		PSHS
		JMP 3
		EQL TOPS
		CLRS
		JMP 57
		PSHS
		JMP 4
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 64
		JMP 18
		SUB $CELL
		ADD 65
		JMP 19
		SUB $CELL
		ADD
		JMP 6
		SUB $CELL
		ADD 65
		JMP 1
		ADD
		JMP $CELL
		ADD 16
		JMP 0
		SUB $CELL
		ADD 110
	ENDIF
	JMP 0
	IF EQL 16
		JMP 6
		SUB $CELL
		ADD
		CLRS
		JMP 56
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 53
		PSHS
		JMP 3
		EQL TOPS
		CLRS
		JMP 51
		PSHS
		JMP 4
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 65
		JMP 18
		SUB $CELL
		ADD 64
		JMP 19
		SUB $CELL
		ADD 65
		JMP 1
		ADD
		JMP $CELL
		ADD 17
		JMP 0
		SUB $CELL
		ADD 190
	ENDIF
	JMP 0
	IF EQL 17               # and into the embeddings of the 4 symbols; cell 10 holds 1.0, a list of one to step with
		JMP 2
		SUB $CELL
		ADD 10
		JMP 5
		SUB $CELL
		ADD 16
		JMP 18
		SUB $CELL
		ADD
		JMP 74
		SUB $CELL
		ADD 63
		CLRS
		JMP 57
		PSHS
		JMP 75
		EQL TOPS
		JMP 76
		ADD 4
		JMP 0
		SUB $CELL
		ADD 18
	ENDIF
	JMP 0
	IF EQL 18               # a call cannot sit inside STLP, so this loop runs through pieces
		JMP 76
		IF
			CLRS
			JMP 74
			JMP $CELL
			PSHS
			JMP 71
			SUB $CELL
			ADD 16
			PSHS
			MULS
			JMP 50
			PSHS
			ADDS
			JMP 4
			EQL TOPS
			CLRS
			JMP 75
			PSHS
			JMP 3
			EQL TOPS
			JMP 1
			ADD
			JMP $CELL
			ADD 19
			JMP 0
			SUB $CELL
			ADD 190
		ELSE
			JMP 0
			SUB $CELL
			ADD 20
		ENDIF
	ENDIF
	JMP 0
	IF EQL 19
		JMP 74
		ADD
		JMP 75
		ADD 16
		JMP 76
		SUB
		JMP 0
		SUB $CELL
		ADD 18
	ENDIF
	JMP 0
	IF EQL 20
		JMP 59
		IF
			SUB
		ENDIF
		IF EQL 0
			JMP 9
			SUB $CELL
			ADD 819200              # 4096 / 0.005
		ENDIF
		JMP 0
		SUB $CELL
		ADD 21
		JMP 60
		SUB
		IF EQL 0                # every 10,000 symbols, print their average loss
			ADD 10000
			CLRS
			PSHS
			JMP 67
			PSHS
			DIVS
			SUB $CELL
			JMP 68
			EQL TOPS
			JMP 2
			SUB $CELL
			ADD 68
			JMP 5
			SUB $CELL
			ADD
			JMP 1
			ADD
			JMP $CELL
			ADD 21
			JMP 0
			SUB $CELL
			ADD 120
		ENDIF
	ENDIF
	JMP 0
	IF EQL 21               # the symbol joins the 4, and the oldest drops out
		CLRS
		JMP 64
		PSHS
		JMP 63
		EQL TOPS
		CLRS
		JMP 65
		PSHS
		JMP 64
		EQL TOPS
		CLRS
		JMP 66
		PSHS
		JMP 65
		EQL TOPS
		CLRS
		JMP 62
		PSHS
		JMP 66
		EQL TOPS
		JMP 0
		SUB $CELL
		ADD 10
	ENDIF

	JMP 0
	IF EQL 30               # FORWARD, the network on the 4 symbols in cells 63 to 66, leaving the chances for the next one in p
		JMP 5                   # x is the 4 embeddings side by side, so one MATVEC line sees all of them
		SUB $CELL
		ADD 16
		JMP 74
		SUB $CELL
		ADD 63
		CLRS
		JMP 53
		PSHS
		JMP 75
		EQL TOPS
		JMP 76
		ADD 4
		JMP 0
		SUB $CELL
		ADD 31
	ENDIF
	JMP 0
	IF EQL 31               # the same loop through pieces as when the embeddings learn
		JMP 76
		IF
			CLRS
			JMP 74
			JMP $CELL
			PSHS
			JMP 71
			SUB $CELL
			ADD 16
			PSHS
			MULS
			JMP 50
			PSHS
			ADDS
			JMP 2
			EQL TOPS
			CLRS
			JMP 75
			PSHS
			JMP 3
			EQL TOPS
			JMP 1
			ADD
			JMP $CELL
			ADD 32
			JMP 0
			SUB $CELL
			ADD 180
		ELSE
			JMP 0
			SUB $CELL
			ADD 33
		ENDIF
	ENDIF
	JMP 0
	IF EQL 32
		JMP 74
		ADD
		JMP 75
		ADD 16
		JMP 76
		SUB
		JMP 0
		SUB $CELL
		ADD 31
	ENDIF
	JMP 0
	IF EQL 33               # the hidden layer, 64 lines of W1 times x
		CLRS
		JMP 51
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 53
		PSHS
		JMP 3
		EQL TOPS
		CLRS
		JMP 54
		PSHS
		JMP 4
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 65
		JMP 18
		SUB $CELL
		ADD 64
		JMP 19
		SUB $CELL
		ADD 65
		JMP 1
		ADD
		JMP $CELL
		ADD 34
		JMP 0
		SUB $CELL
		ADD 110
	ENDIF
	JMP 0
	IF EQL 34
		CLRS
		JMP 54
		PSHS
		JMP 2
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 64
		JMP 1
		ADD
		JMP $CELL
		ADD 35
		JMP 0
		SUB $CELL
		ADD 160
	ENDIF
	JMP 0
	IF EQL 35               # a score for every symbol, 36 lines of W2 times h
		CLRS
		JMP 52
		PSHS
		JMP 2
		EQL TOPS
		CLRS
		JMP 54
		PSHS
		JMP 3
		EQL TOPS
		CLRS
		JMP 55
		PSHS
		JMP 4
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 65
		JMP 18
		SUB $CELL
		ADD 36
		JMP 19
		SUB $CELL
		ADD 65
		JMP 1
		ADD
		JMP $CELL
		ADD 36
		JMP 0
		SUB $CELL
		ADD 110
	ENDIF
	JMP 0
	IF EQL 36
		CLRS
		JMP 55
		PSHS
		JMP 2
		EQL TOPS
		JMP 5
		SUB $CELL
		ADD 36
		JMP 1
		ADD
		JMP $CELL
		ADD 37
		JMP 0
		SUB $CELL
		ADD 200
	ENDIF
	JMP 0
	IF EQL 37
		JMP 1                   # return
		JMP $CELL
		CLRS
		PSHS
		SUB $CELL
		JMP 1
		SUB
		JMP 0
		EQL TOPS
	ENDIF

	JMP 0
	IF EQL 40               # the text is read, so write 1,000 characters, going on from its last 4 symbols
		JMP 61
		ADD 1000
		JMP 0
		SUB $CELL
		ADD 41
	ENDIF
	JMP 0
	IF EQL 41
		JMP 61
		IF
			JMP 1
			ADD
			JMP $CELL
			ADD 42
			JMP 0
			SUB $CELL
			ADD 30
		ELSE
			JMP 58                  # a line break to end on
			JMP $CELL
			PRNTA
			JMP 0
			SUB $CELL               # piece 0 ends the loop, and with it the program
		ENDIF
	ENDIF
	JMP 0
	IF EQL 42               # a random point from 0 up to 1.0
		JMP 2
		SUB $CELL
		ADD 69
		JMP 3
		SUB $CELL
		JMP 4
		SUB $CELL
		ADD 4096
		JMP 5
		SUB $CELL
		ADD
		JMP 1
		ADD
		JMP $CELL
		ADD 43
		JMP 0
		SUB $CELL
		ADD 170
	ENDIF
	JMP 0
	IF EQL 43               # walk around the chances until the point falls inside one, as names_optimised.ruc walks its counts
		JMP 70
		SUB $CELL
		JMP 58
		STLP
			CLRS
			JMP 55
			PSHS
			JMP 70
			PSHS
			ADDS
			JMP $STACK
			PSHS
			JMP 69
			IF LESS $STACK
				JMP 95                  # cell 95 stays 0, so the walk ends
			ELSE
				SUB $STACK
				JMP 70
				ADD
				IF EQL 36               # past the last symbol, back to symbol 0, since the chances can add up to a little under 1.0
					SUB $CELL
				ENDIF
				JMP 58
			ENDIF
		NDLP

		CLRS                    # print its character, and it joins the 4
		JMP 58
		PSHS
		JMP 70
		PSHS
		ADDS
		JMP $STACK
		PRNTA
		CLRS
		JMP 64
		PSHS
		JMP 63
		EQL TOPS
		CLRS
		JMP 65
		PSHS
		JMP 64
		EQL TOPS
		CLRS
		JMP 66
		PSHS
		JMP 65
		EQL TOPS
		CLRS
		JMP 70
		PSHS
		JMP 66
		EQL TOPS
		JMP 61
		SUB
		JMP 0
		SUB $CELL
		ADD 41
	ENDIF
	JMP 0
NDLP
